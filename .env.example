# === Application ===
APP_ENV=development
APP_SECRET_KEY=change-me-to-a-random-secret-key
APP_BASE_URL=http://localhost:8000
DATABASE_URL=sqlite+aiosqlite:///./generador.db

# Encryption key for sensitive data at rest (generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
ENCRYPTION_KEY=change-me-generate-with-fernet

# === Telegram Bot ===
TELEGRAM_BOT_TOKEN=123456:ABC-DEF1234ghIkl-zyx57W2v1u123ew11

# === Google Cloud (for Veo 3 via Vertex AI) ===
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# === Default Gemini API Key (bots can override) ===
GEMINI_API_KEY=your-default-gemini-api-key

# === Default Kling API Key (bots can override) ===
KLING_API_KEY=your-default-kling-api-key

# === Logging ===
LOG_LEVEL=INFO
